# Puntos de entrada que el trazado NO puede deducir solo.
#
# Cada uno lleva escrito POR QUE hace falta.

# El arranque: la cabecera da INIT en 0x4010.
0x4010   # INIT

# La interrupcion: el arranque pone un salto a 0x8CD2 en H.TIMI (0x8032).
0x8CD2

# Ejecutadas en openMSX (tools/omsx_cobertura.tcl: jugando y en la demo) y no alcanzadas por el
